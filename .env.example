# Local chain RPC. Required only when EXECUTION_MODE=TESTNET.
RPC_URL=

# Opt-in fork tests. Leave empty to skip live forking.
FORK_RPC_URL=

# Chain id used by the TypeScript client. 31337 is the local Anvil/Hardhat id.
CHAIN_ID=31337

# Deployed TradingExecutor. Required only when EXECUTION_MODE=TESTNET.
EXECUTOR_ADDRESS=

# Optional addresses used by the deploy script. Not a signer.
ADMIN_ADDRESS=
EXECUTOR_CALLER=

API_PORT=3000
LOG_LEVEL=info

# Optional. The included store is in-memory. db/schema.sql is the PostgreSQL shape.
DATABASE_URL=

# SIMULATED never broadcasts. TESTNET is the only mode that submits a transaction.
EXECUTION_MODE=SIMULATED
